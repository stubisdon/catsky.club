## Local API server environment (Express `server.js`)
#
# Create a file named `.env.server` (gitignored) next to `server.js`
# and paste the values there.
#
# --- Server (server.js) ---
# Required for /api/submit (creates members in Ghost):
GHOST_ADMIN_API_KEY=YOUR_ID:YOUR_HEX_SECRET
#
# Optional:
# PORT=3001
# GHOST_URL=https://your-ghost-domain.com
# GHOST_ADMIN_API_VERSION=v5.0   (use v6.0 if your Ghost is 6.x)
# SIGNUPS_API_TOKEN=dev-only-token
#
# Cloudflare Turnstile secret key — server-side bot verification, enforced on BOTH
# /members/api/send-magic-link/ (step 1, email) and /api/member-profile (step 2, name).
# When unset, signup verification is skipped on both endpoints (fails open). Set it to enforce.
# TURNSTILE_SECRET_KEY=0x....
#
# Cloudflare siteverify URL override — TEST-ONLY, so tests can point verification at a local
# mock instead of Cloudflare. Leave unset. Do NOT set this in production.
# TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
#
# --- Frontend build (deploy.sh uses these for `npm run build`) ---
# Deploy uses VITE_GHOST_URL when set; otherwise it uses GHOST_URL (same value as server — you need one of them).
# VITE_GHOST_URL=https://your-ghost-domain.com
# VITE_GHOST_CONTENT_API_KEY=your_content_api_key_here
# Optional PostHog browser analytics:
# VITE_PUBLIC_POSTHOG_TOKEN=
# VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# VITE_PUBLIC_POSTHOG_ENABLED=true
# Cloudflare Turnstile site key (public) — baked into the client bundle at build time.
# VITE_TURNSTILE_SITE_KEY=0x....

# --- Social feed (GET /api/social-posts) ---
# Powers the "latest posts" section on the landing page. Every variable is optional: a platform
# with no credentials reports an error for itself and renders a "see the latest on <platform>"
# link instead, while the other platforms keep working. See docs/SOCIAL_FEED_SETUP.md.
#
# Instagram Graph API. Business/Creator account linked to a Facebook Page.
# The long-lived token expires every 60 days and must be refreshed.
# INSTAGRAM_ACCESS_TOKEN=
#
# TikTok Display API. OAuth user token with the video.list scope.
# TIKTOK_ACCESS_TOKEN=
#
# YouTube Data API v3. A plain API key (no OAuth, no expiry).
# Leave unset to use the public Atom feed instead, which needs no credentials at all.
# YOUTUBE_API_KEY=
# Defaults to the catsky channel; override only if the channel changes.
# YOUTUBE_CHANNEL_ID=UCaDbdaRYUr6-5aExHdnwa7Q
